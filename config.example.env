# Optional settings for LEGACY modules only; the file is not loaded automatically.
# Copy to .env, edit, then run: source .env
# Current workflow.py init uses --media-root and --cache-root instead.
# Never commit .env, credentials, or machine-specific paths.

# Read by legacy init_run.py, validate_run.py, and harness.py.
export AI_VIDEO_MUSIC_ROOT="${HOME}/Music"

# Used by legacy editor instructions; not consumed by current workspace_layout.py.
export AI_VIDEO_MEDIA_ROOT="${HOME}/Movies/JianyingMedia"

